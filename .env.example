# Copy to .env and fill in. Never commit .env. Read by compose.yml.

# MongoDB (container "mongo"); the server's MONGO_URI is built from these.
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_DATABASE=dsa
# Host port for Compass/mongosh (bound to 127.0.0.1 only)
# MONGO_PORT=27017

# Signs login tokens. Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# Production (`docker compose up`): host port of the app (nginx)
# APP_PORT=8080

# Allowed CORS origin(s), comma-separated.
# Default: http://localhost:8080 in production, http://localhost:5173 in development.
# CLIENT_ORIGIN=
